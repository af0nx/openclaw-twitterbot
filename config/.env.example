# Twitter Bot Pipeline V2 - Environment Variables
# ⚠️  SECURITY: Use Mozilla sops for encryption at rest
# Never commit actual credentials to git

# ====================
# DATABASE (Railway PostgreSQL 16)
# ====================
DATABASE_URL=postgresql://user:password@host.railway.app:5432/dbname?sslmode=verify-full

# ====================
# X/TWITTER API V2 (Basic Tier)
# ====================
X_API_KEY=your_api_key_here
X_API_SECRET=your_api_secret_here
X_ACCESS_TOKEN=your_access_token_here
X_ACCESS_SECRET=your_access_token_secret_here
X_BEARER_TOKEN=your_bearer_token_here

# Optional account sharding (falls back to the main account if omitted)
X_MAIN_DAILY_CAP=100
X_LIVE_API_KEY=your_live_account_api_key
X_LIVE_API_SECRET=your_live_account_api_secret
X_LIVE_ACCESS_TOKEN=your_live_account_access_token
X_LIVE_ACCESS_SECRET=your_live_account_access_secret
X_LIVE_BEARER_TOKEN=your_live_account_bearer_token
X_LIVE_DAILY_CAP=100
X_REPLIES_API_KEY=your_replies_account_api_key
X_REPLIES_API_SECRET=your_replies_account_api_secret
X_REPLIES_ACCESS_TOKEN=your_replies_account_access_token
X_REPLIES_ACCESS_SECRET=your_replies_account_access_secret
X_REPLIES_BEARER_TOKEN=your_replies_account_bearer_token
X_REPLIES_DAILY_CAP=100

# ====================
# OPENROUTER (Unified LLM Routing)
# ====================
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model Routing (matches SkinBetAI tier alignment)
LLM_TIER_ECO=google/gemini-2.5-flash
LLM_TIER_AUTO=deepseek/deepseek-chat
LLM_TIER_PREMIUM=anthropic/claude-3.5-sonnet

# ====================
# TELEGRAM HITL GATEWAY
# ====================
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_ALLOWED_USER_IDS=12345678,87654321  # Comma-separated

# ====================
# REDDIT (Marketing-for-Founders Cross-Post)
# ====================
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_REFRESH_TOKEN=your_refresh_token
REDDIT_USER_AGENT=TwitterBot/2.0 by /u/yourusername

# ====================
# MOBILE PROXY POOL (4G/5G Rotation)
# ====================
MOBILE_PROXY_API_ENDPOINT=https://proxy-provider.com/api/rotate
MOBILE_PROXY_API_KEY=your_proxy_api_key
MOBILE_PROXY_POOL_SIZE=10

# ====================
# SCRAPLING CONFIG
# ====================
SCRAPLING_TIMEOUT=30
SCRAPLING_RETRY_ATTEMPTS=3

# ====================
# MONITORING & ALERTS
# ====================
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
ALERT_WEBHOOK_URL=https://your-webhook-endpoint.com/alerts

# ====================
# FEATURE FLAGS
# ====================
ENABLE_MIROFISH_GUARD=true
ENABLE_AUTO_RLHF=true
ENABLE_REDDIT_CROSSPOST=true
DRY_RUN_MODE=false  # Set to true for testing without posting

# ====================
# ENGAGEMENT TUNING
# ====================
DISAGREEMENT_REPLY_START_HOUR=14
DISAGREEMENT_REPLY_END_HOUR=23
DISAGREEMENT_REPLIES_PER_DAY=2
DISAGREEMENT_PENDING_CAP=1
DISAGREEMENT_VIP_LOOKBACK_HOURS=36
DISAGREEMENT_VIP_LIMIT=40
DISAGREEMENT_COMMENT_LOOKBACK_HOURS=48
DISAGREEMENT_COMMENT_ROOTS_LIMIT=4
DISAGREEMENT_COMMENT_SEARCH_RESULTS=10
DISAGREEMENT_QUOTE_MIN_LIKES=250
DISAGREEMENT_QUOTE_MIN_REPLIES=40
DISAGREEMENT_QUOTE_CHANCE=0.20

DAILY_LIKE_CAP=200
LIKES_PER_CYCLE=40
LIKE_DELAY_MIN_SECONDS=3
LIKE_DELAY_MAX_SECONDS=8
SEARCH_LIKE_DELAY_MIN_SECONDS=4
SEARCH_LIKE_DELAY_MAX_SECONDS=10
PEAK_LIKE_INTERVAL_MINUTES=45
OFFPEAK_LIKE_INTERVAL_MINUTES=90

# Engagement engine cycle intervals
ENGAGEMENT_ENGINE_PEAK_INTERVAL_HOURS=1
ENGAGEMENT_ENGINE_OFFPEAK_INTERVAL_HOURS=2

# ====================
# RATE LIMITS
# ====================
DAILY_TWEET_CAP=38  # Reserve 2 for breaking news
HITL_TIMEOUT_HOURS=4

# Live watcher local trigger loop
LIVE_WATCHER_INTERVAL=12
LIVE_WATCHER_MONITOR_SECONDS=8
LIVE_WATCHER_MONITOR_FPS=1
LIVE_WATCHER_BURST_FRAMES=3
